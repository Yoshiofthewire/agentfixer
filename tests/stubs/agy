#!/usr/bin/env bash
# Programmable `agy` stub. Dispatches on $AF_STEP.
#
# Models agy 1.1.22's one trap: --print takes an OPTIONAL value, so
# `--print --output-format json` makes "--output-format" the prompt and
# leaves "json" a stray positional. The prompt has to be attached with `=`.
# Reproduced here: a bare --print is accepted and takes the NEXT argument as
# its prompt, exactly as the real binary does, so a caller that gets this
# wrong ends up asking the model to write "--output-format" and the test
# that checks the prompt reached it fails.
#
# Extraction is claude-shaped (.structured_output in a JSON envelope on
# stdout) but the success field is not (.status == "SUCCESS").
set -euo pipefail
step="${AF_STEP:-unknown}"
d="${AF_STUB_DIR:?AF_STUB_DIR unset}/agy"
mkdir -p "$d"

prompt="" schema="" want=""
for a in "$@"; do
  case "$want" in
    prompt) prompt="$a"; want=""; continue ;;
    schema) schema="$a"; want=""; continue ;;
    skip) want=""; continue ;;
  esac
  case "$a" in
    --print=*|--prompt=*|-p=*) prompt="${a#*=}" ;;
    --print|--prompt|-p) want=prompt ;;
    --json-schema) want=schema ;;
    --output-format|--model|--effort|--print-timeout|--agent) want=skip ;;
    *) : ;;
  esac
done

[ -n "$prompt" ] || { echo "agy: no prompt given" >&2; exit 1; }
[ -n "$schema" ] || { echo "agy: this stub requires --json-schema" >&2; exit 1; }

printf '%s\n' "$*" >> "$d/$step.args"
printf '%s\n' "$prompt" >> "$d/$step.args"

# Optional side effect, executed in the caller's cwd (the worktree).
if [ -f "$d/$step.sh" ]; then
  bash "$d/$step.sh"
fi

rc=0
if [ -f "$d/$step.exit" ]; then rc="$(cat "$d/$step.exit")"; fi
if [ -f "$d/$step.err" ]; then cat "$d/$step.err" >&2; fi
if [ "$rc" != "0" ]; then exit "$rc"; fi

# A raw envelope overrides everything, so tests can inject malformed output.
if [ -f "$d/$step.envelope" ]; then cat "$d/$step.envelope"; exit 0; fi

status=SUCCESS
if [ -f "$d/$step.status" ]; then status="$(cat "$d/$step.status")"; fi
payload='{}'
if [ -f "$d/$step.json" ]; then payload="$(cat "$d/$step.json")"; fi
jq -n --argjson so "$payload" --arg st "$status" '{
  status: $st, conversation_id: "stub", num_turns: 1,
  duration_seconds: 0.1, response: ($so | tostring),
  usage: {input_tokens: 10, output_tokens: 10, total_tokens: 20},
  structured_output: $so
}'
exit 0
