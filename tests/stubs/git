#!/usr/bin/env bash
# Stub git that intercepts fetch commands and makes them succeed
# Also provides mock remote branches
declare -a args=( "$@" )
work_dir=""
i=0
while [ $i -lt ${#args[@]} ]; do
  arg="${args[$i]}"
  case "$arg" in
    -C)
      work_dir="${args[$((i + 1))]}"
      i=$((i + 2))
      continue
      ;;
    -c)
      i=$((i + 2))
      continue
      ;;
    -*)
      i=$((i + 1))
      continue
      ;;
    *)
      # Found the command
      if [ "$arg" = "fetch" ]; then
        # Mock a successful fetch by creating a local tracking branch
        if [ -n "$work_dir" ]; then
          # Get the current HEAD commit and create a remote tracking ref for it
          local_head=$(/usr/bin/git -C "$work_dir" rev-parse HEAD 2>/dev/null)
          if [ -n "$local_head" ]; then
            /usr/bin/git -C "$work_dir" update-ref refs/remotes/origin/main "$local_head" 2>/dev/null || true
          fi
        fi
        exit 0
      fi
      break
      ;;
  esac
done

# Otherwise, run the real git command
exec /usr/bin/git "$@"
